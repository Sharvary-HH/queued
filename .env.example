DATABASE_URL=postgres://queued:queued@localhost:5432/queued?sslmode=disable
HTTP_ADDR=:8080
LOG_LEVEL=info

# Connection pool size. Leave unset: the worker sizes it as CONCURRENCY + 4
# (one per executor, plus the claimer, the reaper, and the connection the
# NOTIFY listener holds for its whole life). pgx's own default is numCPU, which
# is smaller than that at any real concurrency and shows up as slowness rather
# than as an error.
# DB_MAX_CONNS=

QUEUE=default
CONCURRENCY=8
CLAIM_BATCH=10
POLL_INTERVAL=100ms
DRAIN_TIMEOUT=30s
REAP_INTERVAL=5s
VISIBILITY_TIMEOUT_SECONDS=60
